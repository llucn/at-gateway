# Node environment
NODE_ENV=development
LOG_LEVEL=info

# API Server
API_HOST=0.0.0.0
API_PORT=3000
API_PREFIX=api
CORS_ORIGINS=*

# Database
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=atgw
DB_PASSWORD=atgw
DB_NAME=at_gateway
DB_SYNCHRONIZE=false
DB_LOGGING=false
DB_MIGRATIONS_RUN=true

# JWT Authentication (CHANGE THESE IN PRODUCTION!)
JWT_SECRET=change-me-in-production-must-be-at-least-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-too-in-production-also-32-characters-long
JWT_REFRESH_TTL=30d

# Bootstrap Admin User
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Modem Configuration
MODEM_PORT=
MODEM_BAUD_RATE=115200
MODEM_AUTO_DETECT=true
MODEM_USB_FILTERS=1e0e:9011,1e0e:9001
MODEM_COMMAND_TIMEOUT_MS=10000
MODEM_RECONNECT_DELAY_MS=3000
MODEM_SIM_PIN=
MODEM_SMS_MODE=PDU
MODEM_SMSC=
MODEM_STATUS_POLL_MS=10000

# Audio Configuration
MODEM_AUDIO_MODE=usb
AUDIO_INPUT_DEVICE=default
AUDIO_OUTPUT_DEVICE=default
AUDIO_SAMPLE_RATE=8000
AUDIO_CHANNELS=1
MEDIA_STORAGE_DIR=./storage/recordings
MEDIA_RETENTION_DAYS=90

# TTS (Text-to-Speech)
TTS_PROVIDER=piper
TTS_VOICE=
TTS_PIPER_BIN=piper
TTS_PIPER_MODEL=
TTS_API_KEY=
TTS_API_REGION=
TTS_CACHE_DIR=./storage/tts-cache

# STT (Speech-to-Text)
STT_PROVIDER=whisper-cpp
STT_LANGUAGE=zh
STT_WHISPER_BIN=whisper-cli
STT_WHISPER_MODEL=
STT_API_KEY=
STT_API_REGION=

# Webhooks
WEBHOOK_SMS_URL=
WEBHOOK_CALL_URL=
WEBHOOK_SECRET=
WEBHOOK_TIMEOUT_MS=10000
WEBHOOK_MAX_ATTEMPTS=5
