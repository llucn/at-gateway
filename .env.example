# Docker Compose Environment Variables
# Copy this to .env and customize for Docker deployment

# Security - MUST CHANGE IN PRODUCTION!
JWT_SECRET=change-me-in-production-must-be-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-too-in-production-also-32-characters-long

# Bootstrap Admin (first-time setup)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123!

# Modem - leave empty for auto-detection
MODEM_AUTO_DETECT=true
MODEM_PORT=
MODEM_SIM_PIN=

# Media Providers
TTS_PROVIDER=piper
STT_PROVIDER=whisper-cpp

# Webhooks (optional)
WEBHOOK_SMS_URL=
WEBHOOK_CALL_URL=
WEBHOOK_SECRET=
