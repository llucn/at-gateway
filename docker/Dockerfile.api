# API Dockerfile
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@11.5.0 --activate

# Dependencies
FROM base AS deps
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/shared/package.json ./packages/shared/
COPY packages/at-modem/package.json ./packages/at-modem/
COPY packages/media/package.json ./packages/media/
COPY apps/api/package.json ./apps/api/
RUN pnpm install --frozen-lockfile --prod=false

# Build packages
FROM base AS build-packages
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY packages ./packages
RUN pnpm --filter "@at-gateway/shared" --filter "@at-gateway/at-modem" --filter "@at-gateway/media" build

# Build API
FROM base AS build-api
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=build-packages /app/packages ./packages
COPY package.json pnpm-workspace.yaml tsconfig.base.json ./
COPY apps/api ./apps/api
RUN pnpm --filter "@at-gateway/api" build

# Production
FROM base AS runner
WORKDIR /app

ENV NODE_ENV=production

RUN apk add --no-cache \
    ffmpeg \
    python3 \
    py3-pip \
    && rm -rf /var/cache/apk/*

# Optional: Install TTS/STT tools
# RUN pip3 install piper-tts edge-tts faster-whisper

COPY --from=deps /app/node_modules ./node_modules
COPY --from=build-packages /app/packages/shared/dist ./packages/shared/dist
COPY --from=build-packages /app/packages/shared/package.json ./packages/shared/
COPY --from=build-packages /app/packages/at-modem/dist ./packages/at-modem/dist
COPY --from=build-packages /app/packages/at-modem/package.json ./packages/at-modem/
COPY --from=build-packages /app/packages/media/dist ./packages/media/dist
COPY --from=build-packages /app/packages/media/package.json ./packages/media/
COPY --from=build-api /app/apps/api/dist ./apps/api/dist
COPY --from=build-api /app/apps/api/package.json ./apps/api/
COPY apps/api/src/database ./apps/api/src/database

RUN mkdir -p /app/storage/recordings /app/storage/tts-cache /app/models

EXPOSE 3000

CMD ["node", "apps/api/dist/main.js"]
